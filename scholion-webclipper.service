[Unit]
Description=scholion-webclipper — fetch, extract and compose Scholion webclip notes (Bun, port 8020)
After=network.target

[Service]
Type=simple
User=hermes
WorkingDirectory=/home/hermes/services/scholion-webclipper
ExecStart=/home/hermes/.bun/bin/bun run /home/hermes/services/scholion-webclipper/server.ts

# Restart=always, not on-failure: a SIGTERM combined with on-failure leaves the
# unit stopped, which on this host has meant a service quietly gone after a
# routine signal (same lesson as scholion-places.service).
Restart=always
RestartSec=5

# Secrets live in .env (chmod 600), never in Environment= here: unit files under
# /etc/systemd/system are world-readable.
EnvironmentFile=/home/hermes/services/scholion-webclipper/.env
Environment=HOME=/home/hermes
Environment=PATH=/home/hermes/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# git needs to find the deploy key and the host alias in ~/.ssh/config for
# vault sync/push.
Environment=GIT_TERMINAL_PROMPT=0

[Install]
WantedBy=multi-user.target
