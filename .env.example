# Copy to .env, fill in, and chmod 600. Never commit .env — this repo is public.

# ── the vault ────────────────────────────────────────────────────────────────
# A clone of the Scholion content repository this service writes into. It
# only ever touches VAULT_NOTES_SECTION and VAULT_CLIPPINGS_SECTION, always
# with an explicit pathspec — never the whole tree. See README "Decision 5"
# for why this is a separate clone, not the interactive session's own
# E:\scholion working copy.
#
# Clone with --filter=blob:none: the history is worth having, the blobs of
# every file ever committed are not.
VAULT_DIR=/home/hermes/services/scholion-webclipper/vault
VAULT_NOTES_SECTION=content/notes
VAULT_CLIPPINGS_SECTION=clippings

# Who the commits are attributed to. Not a person: the audit log records
# which principal asked, and the commit records that it was this service
# that wrote. No Co-Authored-By line, ever — see the Scholion CLAUDE.md rule.
GIT_AUTHOR_NAME=scholion-webclipper
GIT_AUTHOR_EMAIL=scholion-webclipper@localhost

# Commit is synchronous in the /save response; push happens in the
# background with retry, so a slow remote doesn't make save feel slow.
AUTO_PUSH=true
PUSH_DELAY_MS=2000

# ── where to listen ──────────────────────────────────────────────────────────
# Loopback only, same as scholion-places and vox-intelligence. Reaching this
# service goes through a reverse proxy that stamps the X-Api-Key, so no
# client ever holds a credential it could swap to escalate itself.
PORT=8020
HOST=127.0.0.1

# ── access ───────────────────────────────────────────────────────────────────
# Principals and what each may do. See acl.example.json.
# Edits take effect without a restart: the file is re-read when its mtime moves.
ACL_PATH=./acl.json

# A ceiling on compose calls, PER PRINCIPAL (each principal gets its own
# window — reused from scholion-places' budget.ts). Sized to stop a retry
# loop, not a person: compose calls a paid LLM through vox-intelligence, so
# an agent stuck retrying is a metered cost, not just a nuisance.
#
# 500/day, not 200: raised after a real batch-import backlog (hundreds of
# URLs) needed more headroom than one interactive-usage day's worth. Because
# the ceiling is per-principal, giving batch its own principal
# (add-scholion-webclip-batch — see acl.example.json) means batch exhausting
# its 500 never blocks the interactive skill's own separate 500 window.
MAX_COMPOSES_PER_MIN=10
MAX_COMPOSES_PER_DAY=500

# ── upstream services ────────────────────────────────────────────────────────
VOX_INTELLIGENCE_URL=http://localhost:8080/api/vox-intelligence
# Budget per vox-intelligence call (webclip-summary, then ghost-audit), passed
# upstream as `timeoutMs` so the model call is abandoned when we give up.
# Two calls per compose: keep 2x this + FETCH_TIMEOUT_MS under nginx's 300s.
VOX_TIMEOUT_MS=90000
# Optional override of the webclip-summary preset's model chain (ids as
# vox-intelligence expects them, e.g. openrouter/openai/gpt-5.4-mini). The
# model that wrote each note is recorded as `generated_by` in its frontmatter.
SUMMARY_MODEL=
SUMMARY_FALLBACK_MODELS=

# ── operations (the compose/save two-phase token) ───────────────────────────
# How long a composed-but-unsaved operation stays valid. A draft against a
# page that has since changed, or a note someone already created by hand in
# the meantime, shouldn't be silently publishable long after it was composed.
OPERATION_TTL_HOURS=24
OPERATIONS_DIR=./operations

# ── extraction ───────────────────────────────────────────────────────────────
# Internal render timeout, shorter than any reasonable HTTP client timeout —
# so a slow page always comes back as a clean `fetch_timeout` response
# instead of the connection hanging (see README "Decision 7").
FETCH_TIMEOUT_MS=30000
MIN_CONTENT_CHARS=400

LOG_DIR=./logs
LOG_RETENTION_DAYS=30
